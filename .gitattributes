# Line endings: LF everywhere, so Windows computers and Linux CI see exactly the same files.
* text=auto eol=lf

# Windows scripts need Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: git must never change them.
*.jar binary
*.jks binary
*.keystore binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
